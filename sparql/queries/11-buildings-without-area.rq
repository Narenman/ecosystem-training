PREFIX ex: <https://ecosystem-training.local/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?building
WHERE {
  GRAPH <https://ecosystem-training.local/graphs/buildings> {
    ?building rdf:type ex:Building .
    OPTIONAL { ?building ex:hasArea ?area . }
    FILTER(!BOUND(?area))
  }
}
ORDER BY ?building
