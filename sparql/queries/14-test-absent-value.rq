PREFIX ex: <https://ecosystem-training.local/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX test: <urn:s3-test:>

SELECT ?reading
WHERE {
  GRAPH test:measurements {
    ?reading rdf:type ex:ElectricityReading .
    FILTER NOT EXISTS { ?reading ex:electricityValue ?value . }
  }
}
ORDER BY ?reading
