PREFIX ex: <https://ecosystem-training.local/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?building ?value
WHERE {
  GRAPH <https://ecosystem-training.local/graphs/measurements> {
    ?reading rdf:type ex:ElectricityReading ;
             ex:forBuilding ?building ;
             ex:observedAt "2016-01-01T00:00:00"^^xsd:dateTime ;
             ex:electricityValue ?value .
  }
}
ORDER BY ?building
